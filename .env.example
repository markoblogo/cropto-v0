SESSION_SECRET=replace_me
JWT_SECRET=replace_me
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional local fallback only (do not use in production)
# SUPABASE_ANON_KEY=your_anon_key
# ALLOW_SUPABASE_ANON_BACKEND=false

# Onchain
DEPLOYER_PRIVATE_KEY=your_private_key
POLYGON_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your_key
CROPT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
CROPT_NFT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_ID=80002
CROPT_DECIMALS=18
ENABLE_MINT=false
MAX_MINT_PER_CALL=10

# Market data ingestion
ENABLE_IGC_POLLING=false
IGC_POLL_INTERVAL_HOURS=24
ENABLE_USDA_AMS_POLLING=true
USDA_AMS_EXPORT_BIDS_URL=https://www.ams.usda.gov/mnreports/jo_gr850.txt
USDA_AMS_MARS_LIST_URL=https://marsapi.ams.usda.gov/services/v1.1/public/listPublishedReports/all
DATA_ANOMALY_THRESHOLD_PCT=15

# Telegram ingestion (optional)
TELEGRAM_BOT_TOKEN=
ENABLE_TELEGRAM_SCRAPER=true
TELEGRAM_SCRAPE_INTERVAL_SEC=600
TELEGRAM_CHANNEL_USERNAME=spike_brokers

# Sea Brokerage Monitor relay (optional but required for live BID/OFFER posting)
SEA_BROKERAGE_TELEGRAM_CHAT_ID=
# Optional comma-separated list for multi-chat broadcasting
SEA_BROKERAGE_TELEGRAM_CHAT_IDS=
# Optional country-specific override (used for UA-origin entries)
SEA_BROKERAGE_TELEGRAM_UA_CHAT_ID=

# Sea Brokerage Monitor broker allowlist (JSON array)
# Example:
# SEA_BROKERAGE_BROKER_ALLOWLIST_JSON=[{"authEmail":"broker@company.com","telegramUsername":"broker_handle","brokerCode":"SK","brokerName":"Sergiy Kozhushkin","companyName":"Southline Brokerage","isActive":true}]
SEA_BROKERAGE_BROKER_ALLOWLIST_JSON=
SEA_BROKERAGE_MONITOR_JWT_SECRET=replace_me_monitor_jwt_secret
VITE_SEA_BROKERAGE_TELEGRAM_BOT_USERNAME=spikemoonbot

# Sea Brokerage Monitor dual-channel relay controls
SEA_BROKERAGE_TELEGRAM_INTERNAL_ENABLED=true
SEA_BROKERAGE_TELEGRAM_INTERNAL_CHAT_ID=
SEA_BROKERAGE_TELEGRAM_INTERNAL_CHAT_IDS=
SEA_BROKERAGE_TELEGRAM_INTERNAL_UA_CHAT_ID=

SEA_BROKERAGE_TELEGRAM_EXTERNAL_ENABLED=false
SEA_BROKERAGE_TELEGRAM_EXTERNAL_CHAT_ID=
SEA_BROKERAGE_TELEGRAM_EXTERNAL_CHAT_IDS=

# last30days ingestion (optional)
# File or directory with JSON outputs from: last30days --emit=json --store
LAST30DAYS_JSON_PATH=
# Optional SQLite fallback path from last30days open variant store
LAST30DAYS_SQLITE_PATH=
